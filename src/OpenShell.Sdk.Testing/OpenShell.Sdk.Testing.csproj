  <PropertyGroup>
    <TargetFrameworks>$(OpenShellSdkTargetFrameworks)</TargetFrameworks>
    <RootNamespace>OpenShell.Testing</RootNamespace>
    <AssemblyName>OpenShell.Sdk.Testing</AssemblyName>
    <PackageId>OpenShell.Net.Testing</PackageId>
    <Description>In-memory fake of the OpenShell gateway client, for unit-testing code that uses OpenShell.Net, the unofficial .NET SDK for NVIDIA OpenShell.</Description>
    <PackageTags>openshell;nvidia-openshell;testing;fake</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenShell.Sdk\OpenShell.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenShell.Sdk.Tests" />
  </ItemGroup>
</Project>
