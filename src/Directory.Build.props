<Project>
  <!--
    SPDX-FileCopyrightText: Copyright (c) 2026 Zoltan Csizmadia
    SPDX-License-Identifier: Apache-2.0
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Versioning: packages carry the version of the NVIDIA/OpenShell release whose protos they are built from
    (UPSTREAM_VERSION), plus an optional fourth component for SDK-only releases: 0.1.7, 0.1.7.1, 0.1.7.2, then
    0.1.8. Release builds pass -p:Version from the tag (the release workflow checks that it matches
    UPSTREAM_VERSION); every other build is a prerelease of the upstream version, 0.1.7-dev by default or
    -p:VersionSuffix=ci.42 in CI.
  -->
  <PropertyGroup>
    <OpenShellUpstreamRelease>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../UPSTREAM_VERSION').Trim())</OpenShellUpstreamRelease>
    <OpenShellUpstreamVersion>$([System.Text.RegularExpressions.Regex]::Match('$(OpenShellUpstreamRelease)', '^v?(\d+\.\d+\.\d+)').Groups[1].Value)</OpenShellUpstreamVersion>
    <OpenShellUpstreamVersion Condition="'$(OpenShellUpstreamVersion)' == ''">0.0.0</OpenShellUpstreamVersion>
    <VersionPrefix>$(OpenShellUpstreamVersion)</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">dev</VersionSuffix>
    <PackageReleaseNotes>Built from the gRPC protos of NVIDIA OpenShell $(OpenShellUpstreamRelease). Release notes: https://github.com/zcsizmadia/OpenShell.Net/releases</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="OpenShellUpstreamRelease" Value="$(OpenShellUpstreamRelease)" />
  </ItemGroup>

  <!-- NuGet metadata shared by every package under src/. -->
  <PropertyGroup>
    <Authors>Zoltan Csizmadia</Authors>
    <Copyright>Copyright (c) 2026 Zoltan Csizmadia</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/zcsizmadia/OpenShell.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zcsizmadia/OpenShell.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- Symbol packages (.snupkg) go to the nuget.org symbol server; Source Link maps them to the commit on GitHub. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Repository-relative source paths in CI builds, so the shipped PDBs don't contain runner paths. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--
      Checks the package on pack: every target framework exposes a compatible API, and the public API stays
      compatible with PackageValidationBaselineVersion, the latest version on nuget.org. Raise it after each release;
      intentional breaks go in a reviewed CompatibilitySuppressions.xml.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.1.8</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
