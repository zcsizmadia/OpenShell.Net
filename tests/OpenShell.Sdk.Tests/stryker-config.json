{
  "stryker-config": {
    "project": "OpenShell.Sdk.csproj",
    "test-runner": "mtp",
    "target-framework": "net10.0",
    "reporters": ["html", "json", "markdown", "progress", "cleartext"],
    "thresholds": {
      "high": 85,
      "low": 70,
      "break": 0
    },
    "mutate": [
      "!**/Policy/PolicyModels.cs",
      "!**/Providers/ProviderProfileModels.cs",
      "!**/Providers/ProviderReadinessModels.cs"
    ],
    "ignore-methods": ["ConfigureAwait", "Log*"]
  }
}
