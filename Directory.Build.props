<Project>
  <!--
    SPDX-FileCopyrightText: Copyright (c) 2026 Zoltan Csizmadia
    SPDX-License-Identifier: Apache-2.0
  -->
  <PropertyGroup Label="Target frameworks">
    <!--
      The only place that lists target frameworks; every project follows.
      OpenShellSdkTargetFrameworks: the builds shipped in the packages. Add a newer framework only when the code needs
      its APIs; apps on newer runtimes use the newest build listed here.
      OpenShellTestTargetFrameworks: the runtimes the tests run on, including newer ones without a dedicated build.
      Also update: the dotnet-version list in .github/workflows/ci.yml, release.yml, upstream-sync.yml and docs.yml, the
      TargetFramework of the API reference in docs/docfx.json, the SDK pin in global.json, and the .NET badge in
      README.md.
    -->
    <OpenShellSdkTargetFrameworks>net8.0;net10.0</OpenShellSdkTargetFrameworks>
    <OpenShellTestTargetFrameworks>$(OpenShellSdkTargetFrameworks);net11.0</OpenShellTestTargetFrameworks>
  </PropertyGroup>
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
