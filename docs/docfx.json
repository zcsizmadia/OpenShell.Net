{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "OpenShell.Sdk/OpenShell.Sdk.csproj",
            "OpenShell.Sdk.DependencyInjection/OpenShell.Sdk.DependencyInjection.csproj",
            "OpenShell.Sdk.Testing/OpenShell.Sdk.Testing.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0",
        "Configuration": "Release"
      },
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["**/*.{md,yml}"],
        "exclude": ["snippets/**", "obj/**"]
      }
    ],
    "output": "../artifacts/docs",
    "template": ["default", "modern"],
    "xref": ["https://learn.microsoft.com/en-us/dotnet/.xrefmap.json"],
    "globalMetadata": {
      "_appName": "OpenShell.Net",
      "_appTitle": "OpenShell.Net",
      "_appFooter": "OpenShell.Net is a community project, not affiliated with or endorsed by NVIDIA. Apache-2.0.",
      "_enableSearch": true
    }
  }
}
