TestResults/
.cache/
artifacts/
*.user
.vs/
bin/
obj/

# Keep the SDK source directory Rootfs/ tracked even if a global `rootfs/` ignore rule
# matches it on a case-insensitive file system.
!Rootfs/

# Package smoke tests (scripts/ci.sh smoke and aot).
tests/package-smoke/.packages/
tests/package-smoke/.aot/

# Stryker.NET mutation testing output.
StrykerOutput/

# Documentation site (scripts/docs.sh): the generated API metadata; the site itself goes to artifacts/docs/.
docs/api/*
!docs/api/index.md
docs/_site/
